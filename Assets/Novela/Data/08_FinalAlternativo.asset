  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6360b9f9b32abb6459ab60c89d6426a7, type: 3}
  m_Name: 08_FinalAlternativo
  m_EditorClassIdentifier: Assembly-CSharp::StoryNode
  nodeID: FINAL_ALTERNATIVO
  location: {fileID: 11400000, guid: 20428f014fd8b534ba039d30a0d1f24e, type: 2}
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 5c127c1e689553644bb8a23c9f07304c, type: 2}
    customPortrait: {fileID: 0}
    text: "\xA1Basta de protocolos y rezos! \xA1Voy a destrozarte con mis propios
      pu\xF1os, monstruo!"
    sfx: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 3e97d6b78b662594e836f9c1b2c56e6d, type: 2}
    customPortrait: {fileID: 0}
    text: "\xA1Mateo, no! \xA1Sin aplicar las medidas ni el ritual de protecci\xF3n
      no tenemos ninguna oportunidad!"
    sfx: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 4c86093a05c3b5640b33101950a0bf2d, type: 2}
    customPortrait: {fileID: 0}
    text: "\xA1JA JA JA! \xA1Pobre iluso cegado por la soberbia y la imprudencia!"
    sfx: {fileID: 0}
  - speaker: {fileID: 0}
    customPortrait: {fileID: 0}
    text: "Buziraco aparta a Mateo de un solo golpe. Al no completarse el ritual
      ni respetarse las medidas de seguridad, el demonio desata una falla masiva.
      Riendo en las sombras, la criatura escapa mientras Cali queda sumida en la
      destrucci\xF3n."
    sfx: {fileID: 0}
  nodeType: 2
  nextLinearNode: {fileID: 0}
  choices: []
  endingType: 1

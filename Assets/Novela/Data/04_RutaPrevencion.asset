  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6360b9f9b32abb6459ab60c89d6426a7, type: 3}
  m_Name: 04_RutaPrevencion
  m_EditorClassIdentifier: Assembly-CSharp::StoryNode
  nodeID: RUTA_PREVENCION
  location: {fileID: 11400000, guid: 86fdfbf48b31e6249b490f1c8d495b2c, type: 2}
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 5c127c1e689553644bb8a23c9f07304c, type: 2}
    customPortrait: {fileID: 0}
    text: "\xA1R\xE1pido, entremos a la iglesia colonial! \xA1Aqu\xED hay columnas
      estructurales de hormig\xF3n grueso!"
    sfx: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 3e97d6b78b662594e836f9c1b2c56e6d, type: 2}
    customPortrait: {fileID: 0}
    text: "\xA1Excelente! Adopta la posici\xF3n de protecci\xF3n: ag\xE1chate, c\xFAbrete
      y sost\xE9n firme junto a la columna lejos de ventanas y objetos colgantes."
    sfx: {fileID: 0}
  - speaker: {fileID: 0}
    customPortrait: {fileID: 0}
    text: "Pasan los segundos m\xE1s intensos del temblor. La estructura resiste
      y los escombros caen fuera de su zona segura. El manuscrito y ambos permanecen
      a salvo."
    sfx: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 3e97d6b78b662594e836f9c1b2c56e6d, type: 2}
    customPortrait: {fileID: 0}
    text: El sismo principal ha cesado. Ahora evacuemos ordenadamente hacia la zona
      abierta y despejada del Cerro de las Tres Cruces para realizar el ritual.
    sfx: {fileID: 0}
  nodeType: 0
  nextLinearNode: {fileID: 11400000, guid: 0270b3a459add6346bf2738d22de4f2e, type: 2}
  choices: []
  endingType: 0

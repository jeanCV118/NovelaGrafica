  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6360b9f9b32abb6459ab60c89d6426a7, type: 3}
  m_Name: 07_FinalBueno
  m_EditorClassIdentifier: Assembly-CSharp::StoryNode
  nodeID: FINAL_BUENO
  location: {fileID: 11400000, guid: 20428f014fd8b534ba039d30a0d1f24e, type: 2}
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 5c127c1e689553644bb8a23c9f07304c, type: 2}
    customPortrait: {fileID: 0}
    text: "\xA1Utilizaremos las provisiones del kit de emergencia y el manuscrito
      intacto para canalizar las frecuencias de la tierra!"
    sfx: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 3e97d6b78b662594e836f9c1b2c56e6d, type: 2}
    customPortrait: {fileID: 0}
    text: "\xA1In nomine Patris! \xA1Que las Tres Cruces canalicen la estabilidad
      y la paz para nuestra ciudad!"
    sfx: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 4c86093a05c3b5640b33101950a0bf2d, type: 2}
    customPortrait: {fileID: 0}
    text: "\xA1NOOOO! \xA1La luz de las cruces... la preparaci\xF3n y serenidad de
      los hombres neutralizan mi caos...!"
    sfx: {fileID: 0}
  - speaker: {fileID: 0}
    customPortrait: {fileID: 0}
    text: Las tres imponentes cruces resplandecen con un haz dorado. Buziraco es
      arrastrado y sellado en las profundidades. El temblor cesa por completo y el
      sol vuelve a iluminar una Cali a salvo.
    sfx: {fileID: 0}
  nodeType: 2
  nextLinearNode: {fileID: 0}
  choices: []
  endingType: 0

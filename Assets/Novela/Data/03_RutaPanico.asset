  m_Script: {fileID: 11500000, guid: 6360b9f9b32abb6459ab60c89d6426a7, type: 3}
  m_Name: 03_RutaPanico
  m_EditorClassIdentifier: Assembly-CSharp::StoryNode
  nodeID: RUTA_PANICO
  location: {fileID: 11400000, guid: b15bac87da3f1634d92c350ab8313e15, type: 2}
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 5c127c1e689553644bb8a23c9f07304c, type: 2}
    customPortrait: {fileID: 0}
    text: "\xA1No hay tiempo para esconderse! \xA1Voy a enfrentarlo ahora mismo!"
    sfx: {fileID: 0}
  - speaker: {fileID: 0}
    customPortrait: {fileID: 0}
    text: Mateo corre despavorido por el medio de la calle mientras el terremoto
      arrecia. Una cornisa colapsa desde un edificio cercano.
    sfx: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 5c127c1e689553644bb8a23c9f07304c, type: 2}
    customPortrait: {fileID: 0}
    text: "\xA1Agh! \xA1Los escombros... me cayeron encima! El manuscrito... \xA1se
      han rasgado varias p\xE1ginas del ritual!"
    sfx: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 3e97d6b78b662594e836f9c1b2c56e6d, type: 2}
    customPortrait: {fileID: 0}
    text: "\xA1Te dije que no corrieras durante el sismo! La ca\xEDda de objetos
      es la principal causa de heridas. Ahora estamos lastimados y con el ritual
      da\xF1ado... pero debemos subir al Cerro de las Tres Cruces."
    sfx: {fileID: 0}
  nodeType: 0
  nextLinearNode: {fileID: 11400000, guid: 0270b3a459add6346bf2738d22de4f2e, type: 2}
  choices: []
  endingType: 0

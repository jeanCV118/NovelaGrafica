  m_Name: 02_Decision1
  m_EditorClassIdentifier: Assembly-CSharp::StoryNode
  nodeID: DECISION_1
  location: {fileID: 11400000, guid: b15bac87da3f1634d92c350ab8313e15, type: 2}
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 5c127c1e689553644bb8a23c9f07304c, type: 2}
    customPortrait: {fileID: 0}
    text: "El suelo no deja de moverse y caen pedazos de mamposter\xEDa. \xBFQu\xE9
      hacemos ahora?"
    sfx: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 3e97d6b78b662594e836f9c1b2c56e6d, type: 2}
    customPortrait: {fileID: 0}
    text: "\xA1Es el momento m\xE1s cr\xEDtico del sismo! Cualquier decisi\xF3n en
      p\xE1nico puede ser fatal."
    sfx: {fileID: 0}
  nodeType: 1
  nextLinearNode: {fileID: 0}
  choices:
  - choiceText: "Salir corriendo en p\xE1nico para intentar atacar a Buziraco en
      la calle"
    targetNode: {fileID: 11400000, guid: 7cffc1cf151619342b2e67dba2647974, type: 2}
  - choiceText: Resguardarse junto a una columna resistente en la Iglesia Colonial
      para leer el manuscrito
    targetNode: {fileID: 11400000, guid: 6e0c68b138f583044b8bfdd404eaf9b0, type: 2}
  endingType: 0

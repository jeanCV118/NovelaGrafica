  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6360b9f9b32abb6459ab60c89d6426a7, type: 3}
  m_Name: 01_Introduccion
  m_EditorClassIdentifier: Assembly-CSharp::StoryNode
  nodeID: INTRODUCCION
  location: {fileID: 11400000, guid: b15bac87da3f1634d92c350ab8313e15, type: 2}
  dialogueLines:
  - speaker: {fileID: 0}
    customPortrait: {fileID: 0}
    text: "El cielo sobre Cali se oscurece repentinamente. Un rugido subterr\xE1neo
      sacude las calles del centro hist\xF3rico."
    sfx: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 4c86093a05c3b5640b33101950a0bf2d, type: 2}
    customPortrait: {fileID: 0}
    text: "\xA1Despierto de mi letargo! \xA1Las fallas de la tierra responder\xE1n
      a mi ira y Cali caer\xE1 bajo mi poder!"
    sfx: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 5c127c1e689553644bb8a23c9f07304c, type: 2}
    customPortrait: {fileID: 0}
    text: "\xA1Es Buziraco! La leyenda era real... Tengo el manuscrito antiguo, pero
      la tierra tiembla con demasiada fuerza."
    sfx: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 3e97d6b78b662594e836f9c1b2c56e6d, type: 2}
    customPortrait: {fileID: 0}
    text: "\xA1Mateo, mant\xE9n la calma! Un terremoto ha comenzado, \xA1debemos
      protegernos antes de que los edificios colapsen!"
    sfx: {fileID: 0}
  nodeType: 0
  nextLinearNode: {fileID: 11400000, guid: 15c741e225b7d4445916f8661a850540, type: 2}
  choices: []
  endingType: 0

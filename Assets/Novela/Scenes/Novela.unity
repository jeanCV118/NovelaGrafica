  m_Script: {fileID: 11500000, guid: 4cfb41cd6e2328c41afec9edd3411641, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EndingsManager
  endings:
  - id: FINAL_BUENO
    title: 'Final Bueno: La Luz de las Tres Cruces'
    description: "Mateo y el Padre Esteban aplicaron los protocolos de prevenci\xF3n
      y activaron el ritual sagrado. Las Tres Cruces brillaron con luz divina, sellando
      a Buziraco en las profundidades y salvando a Cali."
    cardImage: {fileID: 21300000, guid: 37d1fa07970a2794ba12de6074333673, type: 3}
  - id: FINAL_ALTERNATIVO
    title: 'Final Alternativo: La Falla Desatada'
    description: "Cegado por la desesperaci\xF3n y el p\xE1nico, Mateo intent\xF3
      enfrentar al demonio a golpes ignorando las medidas de seguridad. El ritual
      fracas\xF3, la falla tel\xFArica colaps\xF3 y Buziraco escap\xF3 dejando a
      Cali en ruinas."
    cardImage: {fileID: 21300000, guid: 2022f0e6a0c04a6479dd4705687ccbd8, type: 3}
